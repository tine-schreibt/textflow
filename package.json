{
  "name": "textFlow",
  "version": "0.2.5",
  "description": "Display, browse and edit multiple notes as one continuous document (flow). Flows can be defined using bookmarks, paths, tags and properties. Edits are automatically synced back to their source notes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "compilerOptions": {
    "types": [
      "node"
    ]
  },
  "include": [
    "**/*.ts"
  ],
  "keywords": [
    "scrivenings",
    "dynamic documents",
    "compilation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "6.8.1",
    "@codemirror/language": "6.10.8",
    "@codemirror/state": "6.5.1",
    "@codemirror/view": "6.36.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.10.6",
    "@typescript-eslint/eslint-plugin": "8.20.0",
    "@typescript-eslint/parser": "8.20.0",
    "builtin-modules": "4.0.0",
    "codemirror": "6.0.1",
    "esbuild": "0.25.0",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "9.36.0",
    "fuse.js": "7.1.0",
    "js-yaml": "^4.1.0",
    "obsidian": "^1.8.0",
    "obsidian-dataview": "0.5.51",
    "tslib": "2.8.1",
    "typescript": "5.7.3",
    "xxhashjs": "^0.2.2"
  },
  "devDependencies": {
    "@types/xxhashjs": "^0.2.4"
  }
}
