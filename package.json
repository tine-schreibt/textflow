{
  "name": "textFlow",
  "version": "0.2.14",
  "description": "Compile multiple notes into a single editable flow - like Scrivenings. Define from paths/tags/props or bookmarks. Auto-sync flow <-> source notes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "scrivenings",
    "dynamic documents",
    "compilation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "25.5.2",
    "@typescript-eslint/eslint-plugin": "8.58.1",
    "@typescript-eslint/parser": "8.58.1",
    "builtin-modules": "5.0.0",
    "esbuild": "0.28.0",
    "esbuild-plugin-copy": "2.1.1",
    "eslint": "10.2.0",
    "fuse.js": "7.3.0",
    "js-yaml": "4.1.1",
    "obsidian": "1.12.3",
    "obsidian-dataview": "^0.5.68",
    "tslib": "2.8.1",
    "typescript": "6.0.2",
    "xxhash-wasm": "1.1.0"
  },
  "resolutions": {
    "svelte": "^5.53.5"
  }
}
