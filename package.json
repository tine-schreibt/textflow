{
  "name": "textFlow",
  "version": "0.2.12",
  "description": "Compile multiple notes into a single editable flow - like Scrivenings. Define from paths/tags/props or bookmarks. Auto-sync flow <-> source notes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "scrivenings",
    "dynamic documents",
    "compilation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.10.6",
    "@typescript-eslint/eslint-plugin": "8.20.0",
    "@typescript-eslint/parser": "8.20.0",
    "builtin-modules": "4.0.0",
    "esbuild": "0.25.0",
    "esbuild-plugin-copy": "2.1.1",
    "eslint": "9.36.0",
    "fuse.js": "7.1.0",
    "js-yaml": "4.1.0",
    "obsidian": "1.12.3",
    "obsidian-dataview": "0.5.51",
    "tslib": "2.8.1",
    "typescript": "5.7.3",
    "xxhash-wasm": "1.1.0"
  }
}
